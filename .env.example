# ==============================================================================
# W'S PLATFORM ENVIRONMENT CONFIGURATION
# Copy to .env for local development
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ws_db?sslmode=disable

# Supabase Auth & Realtime
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cloudflare Stream (Video Ingestion & Playback)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token
CLOUDFLARE_WEBHOOK_SECRET=your-cloudflare-webhook-secret

# Payment Providers (Google Play Billing / Sandbox)
PAYMENT_PROVIDER=sandbox
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=your-fcm-project-id
FIREBASE_CREDENTIALS_JSON=

# Platform Parameters
CREATOR_ROYALTY_BPS=200
BASE_W_PRICE=1
SIGNUP_BONUS_W=50
